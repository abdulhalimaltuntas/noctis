#!/usr/bin/env python3
"""NOCTIS test CLI: an interactive program that behaves like an AI coding tool
and performs deterministic file operations. It never connects to a real AI service.

Interactive commands (one command per line):
  write  <path> <text>      write the file (open/truncate/write); \\n escapes become line breaks
  atomic <path> <text>      write a temp file and swap it in with rename (atomic save)
  append <path> <text>      append to the end
  replace <path> <old> <new>  replace text in the file (in-place write)
  mkdir  <path>             create a folder
  delete <path>             delete the file
  rename <old> <new>        rename
  slow   <path> <n>         write in n chunks 50 ms apart (write-settle test)
  ask    <question>         ask a confirmation question and wait for the answer (y/n)
  sleep  <seconds>
  color                     print an ANSI color sample
  exit   [kod]

Batch mode: noctis-fake-ai --batch 'write a.txt hello' 'delete b.txt'
"""
import os
import sys
import time

RESET = "\033[0m"
VIOLET = "\033[38;2;167;139;250m"
CYAN = "\033[36m"
GREEN = "\033[32m"
RED = "\033[31m"


def unescape(s: str) -> str:
    return s.encode("utf-8").decode("unicode_escape").encode("latin-1").decode("utf-8")


def out(msg: str) -> None:
    sys.stdout.write(msg + "\r\n" if sys.stdout.isatty() else msg + "\n")
    sys.stdout.flush()


def ensure_parent(path: str) -> None:
    parent = os.path.dirname(path)
    if parent:
        os.makedirs(parent, exist_ok=True)


def run(line: str) -> int | None:
    parts = line.strip().split(" ", 2)
    if not parts or not parts[0]:
        return None
    cmd = parts[0]
    try:
        if cmd == "write":
            ensure_parent(parts[1])
            with open(parts[1], "w", encoding="utf-8", newline="") as f:
                f.write(unescape(parts[2]) if len(parts) > 2 else "")
            out(f"{GREEN}written{RESET} {parts[1]}")
        elif cmd == "atomic":
            ensure_parent(parts[1])
            tmp = os.path.join(os.path.dirname(parts[1]) or ".", f".{os.path.basename(parts[1])}.tmp{os.getpid()}")
            with open(tmp, "w", encoding="utf-8", newline="") as f:
                f.write(unescape(parts[2]) if len(parts) > 2 else "")
                f.flush()
                os.fsync(f.fileno())
            os.replace(tmp, parts[1])
            out(f"{GREEN}saved atomically{RESET} {parts[1]}")
        elif cmd == "append":
            ensure_parent(parts[1])
            with open(parts[1], "a", encoding="utf-8", newline="") as f:
                f.write(unescape(parts[2]) if len(parts) > 2 else "")
            out(f"{GREEN}appended{RESET} {parts[1]}")
        elif cmd == "replace":
            path = parts[1]
            old, new = parts[2].split(" ", 1)
            with open(path, "r", encoding="utf-8", newline="") as f:
                text = f.read()
            with open(path, "w", encoding="utf-8", newline="") as f:
                f.write(text.replace(unescape(old), unescape(new)))
            out(f"{GREEN}replaced{RESET} {path}")
        elif cmd == "mkdir":
            os.makedirs(parts[1], exist_ok=True)
            out(f"{GREEN}folder{RESET} {parts[1]}")
        elif cmd == "delete":
            os.remove(parts[1])
            out(f"{RED}deleted{RESET} {parts[1]}")
        elif cmd == "rename":
            ensure_parent(parts[2])
            os.rename(parts[1], parts[2])
            out(f"{CYAN}moved{RESET} {parts[1]} -> {parts[2]}")
        elif cmd == "slow":
            n = int(parts[2]) if len(parts) > 2 else 5
            ensure_parent(parts[1])
            with open(parts[1], "w", encoding="utf-8") as f:
                for i in range(n):
                    f.write(f"chunk {i}\n")
                    f.flush()
                    time.sleep(0.05)
            out(f"{GREEN}written slowly{RESET} {parts[1]}")
        elif cmd == "ask":
            sys.stdout.write(f"{VIOLET}?{RESET} {' '.join(parts[1:])} [y/n] ")
            sys.stdout.flush()
            ans = sys.stdin.readline().strip()
            out(f"answer: {ans}")
        elif cmd == "sleep":
            time.sleep(float(parts[1]))
        elif cmd == "color":
            out(f"{VIOLET}violet{RESET} {CYAN}cyan{RESET} {GREEN}green{RESET} {RED}red{RESET} \033[1mbold{RESET}")
        elif cmd == "exit":
            return int(parts[1]) if len(parts) > 1 else 0
        else:
            out(f"{RED}unknown command{RESET}: {cmd}")
    except Exception as e:  # noqa: BLE001
        out(f"{RED}error{RESET}: {e}")
    return None


def main() -> int:
    args = sys.argv[1:]
    if args and args[0] == "--version":
        print("noctis-fake-ai 1.0 (test)")
        return 0
    if args and args[0] == "--batch":
        for line in args[1:]:
            code = run(line)
            if code is not None:
                return code
        return 0
    out(f"{VIOLET}noctis-fake-ai{RESET} — test tool · cwd: {os.getcwd()}")
    while True:
        sys.stdout.write(f"{CYAN}fake-ai>{RESET} ")
        sys.stdout.flush()
        line = sys.stdin.readline()
        if not line:
            return 0
        code = run(line)
        if code is not None:
            return code


if __name__ == "__main__":
    sys.exit(main())
